rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }

    match /users/{uid} {
      allow read: if signedIn();
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.bio.size() <= 200;
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // Username reservation: first come, first served, never reassigned by others.
    match /usernames/{name} {
      allow read: if signedIn();
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && name.matches('^[a-z0-9_]{3,20}$');
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }

    // Chat id = two uids sorted and joined with "_"
    match /chats/{chatId} {
      allow read: if signedIn() && request.auth.uid in resource.data.members;
      allow create: if signedIn() && request.auth.uid in request.resource.data.members
        && request.resource.data.members.size() == 2
        && chatId == request.resource.data.members[0] + '_' + request.resource.data.members[1];
      allow update: if signedIn() && request.auth.uid in resource.data.members
        && request.resource.data.members == resource.data.members;

      match /messages/{mid} {
        function member() { return request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members; }
        allow read: if signedIn() && member();
        allow create: if signedIn() && member() && request.resource.data.from == request.auth.uid
          && request.resource.data.text is string && request.resource.data.text.size() <= 4000;
        allow delete: if signedIn() && member() && resource.data.from == request.auth.uid;
      }
    }
  }
}
